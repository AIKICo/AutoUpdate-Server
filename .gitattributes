# Auto-normalize line endings
* text=auto

# Linux shell scripts and configurations MUST always use LF (UNIX line endings)
*.sh text eol=lf
*.service text eol=lf
Makefile text eol=lf
Dockerfile* text eol=lf
*.ini text eol=lf

# Windows specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf
*.vcxproj* text eol=crlf

# Binary files
*.exe binary
*.dll binary
*.tar.gz binary
*.zip binary
*.so binary
*.a binary
*.db binary
*.png binary
*.jpg binary
*.ico binary