[Unit]
Description=AutoUpdater.NET Enterprise Web & Update Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/autoupdate-server
ExecStart=/opt/autoupdate-server/autoupdate-server -c /opt/autoupdate-server/config.ini
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
